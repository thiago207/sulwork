# Copie para .env (cp .env.example .env), preencha e proteja com chmod 600.
# O .env real nunca vai para o git.

# Nome do banco criado pelo PostgreSQL na primeira subida
DB_NOME=sulwork

# Usuário dono do banco, usado também pelo backend para conectar
DB_USUARIO=sulwork

# Senha do banco. Gere uma forte com: openssl rand -hex 24
DB_SENHA=troque-esta-senha

# Domínio do front, sem protocolo. O Caddy emite o certificado HTTPS para ele
FRONT_DOMINIO=sulwork.tech

# Domínio da API, sem protocolo. O Caddy emite o certificado HTTPS para ele
API_DOMINIO=api.sulwork.tech

# Origens que podem chamar a API pelo navegador (CORS): URL do front com protocolo e sem barra final
CORS_ORIGENS=https://sulwork.tech

# URL da API que o navegador usa, sem /api no final. É gravada no JavaScript no build do front
VITE_API_URL=https://api.sulwork.tech
